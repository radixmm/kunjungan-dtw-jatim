# ==== Wajib di produksi. Bila kosong, aplikasi berjalan dalam MODE DEMO. ====

# OAuth Client ID (tipe "Web application") dari Google Cloud Console.
# Authorized JavaScript origins: https://<domain-anda>, http://localhost:3000
GOOGLE_CLIENT_ID=

# Postgres (Neon / Supabase / Cloud SQL). Kosong = PGlite lokal di folder .pglite (hanya untuk uji).
DATABASE_URL=

# Rahasia acak, minimal 32 karakter. Buat dengan: openssl rand -base64 48
# EMAIL_PEPPER  : kunci HMAC untuk mengubah email menjadi ID pengunjung. JANGAN diganti setelah go-live
#                 (ID pengunjung lama tidak akan cocok lagi). Simpan di tempat aman terpisah.
# QR_SECRET     : kunci tanda tangan QR. Mengganti = semua QR cetak harus dicetak ulang.
# SESSION_SECRET: kunci cookie sesi pengunjung dan admin.
EMAIL_PEPPER=
QR_SECRET=
SESSION_SECRET=

# Email yang boleh membuka dashboard (pisahkan koma). Domain bisa dengan awalan @, mis. @jatimprov.go.id
ADMIN_EMAILS=

# Radius verifikasi lokasi bawaan (meter). Bisa ditimpa per DTW di data/pilot.json
GEO_RADIUS_M=1500

# Sel agregat pola perjalanan dengan jumlah di bawah ini disembunyikan (anonimitas). Rekomendasi produksi: 5
MIN_CELL=1
